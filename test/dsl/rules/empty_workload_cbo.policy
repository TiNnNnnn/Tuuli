# Checked-in workloads use empty schemas, so the native stats-gated LeftJoin
# expansion never qualifies. Keep it available to dedicated replacement tests
# without adding spurious alternatives to the workload comparison.
- rule: c17232f27a25923d
  enabled: false

# These equivalences duplicate one or both inputs. Bound their workload search
# breadth while retaining the unbounded mode for explicit diagnostics.
- rule: 8423cca3e71db53d
  budget:
    per_node: 1
    per_rule: 1
    per_query: 128
- rule: f2ac7b4091944c8e
  budget:
    per_node: 1
    per_rule: 1
    per_query: 128
