Agg<a0 a1 f0 s0 p0>(Input<t0>)|Agg<a2 a11 f1 s1 p3>(LeftApply<p2 a3 a4 a5>(Input<t1>,Compute<e0 a6 s2>(Input<t2>)))|TableEq(t1,t0);AttrsEq(a2,a0);SchemaEq(s1,s0);PredicateEq(p3,p0);ExprListAny(f0,f1,e0,a6,s2,p2,a3,a4,a5,a10,t2);FuncAttrs(a11,f1)

