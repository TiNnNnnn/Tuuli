# SYNTAX_ONLY legacy_hash=92983d6d3650ab0c; native expression proof: UNKNOWN (fresh NULL allocation lowering unsupported).
LeftJoin<p0 a0 a1>(Input<t0>,Input<t1>)|Union<a2 s0 a3 a4>(InnerJoin<p1 a5 a6>(Input<t2>,Input<t3>),Compute<e0 a7 s1>(AntiJoin<p2 a8 a9>(Input<t4>,Input<t5>)))|t2 := t0;t4 := t0;TableShared(t2,t4);t3 := t1;t5 := t1;TableShared(t3,t5);p1 := p0;p2 := p0;a5 := a0;a6 := a1;a8 := a0;a9 := a1;OutputAttrs(a10,t0);OutputAttrs(a11,t1);AttrsUnion(a2,a10,a11);SchemaFromAttrs(s0,a2);a3 := a2;e0 := ExprNulls(a11);OutputAttrs(a12,e0);AttrsUnion(a4,a10,a12);AttrsEmpty(a7);SchemaFromAttrs(s1,a12);Deterministic(p0)

# Safe decomposition of CXformInnerApplyWithOuterKey2InnerJoin. A
# NULL-rejecting Apply predicate first exposes unmatched rows through
