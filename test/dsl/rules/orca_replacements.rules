AntiJoinNotIn<p0 a0 a1>(Input<t0>,Input<t1>)|Union<a2 s0 a3 a4>(Exists(Filter<p1 a5>(Input<t2>),Input<t3>),NotExists(Input<t4>,Input<t5>))|TableEq(t2,t0);TableEq(t4,t0);TableShared(t2,t4);TableEq(t3,t1);TableEq(t5,t1);TableShared(t3,t5);PredicateEq(p1,p0);AttrsEq(a5,a0);AttrsSub(a0,t0);AttrsEmpty(a1);OutputAttrs(a2,t0);SchemaFromAttrs(s0,a2);AttrsEq(a3,a2);AttrsEq(a4,a2);Deterministic(p0);ErrorFree(p0)

# Replace CXformInlineCTEConsumer. The table symbol is the consumer's existing
# column-remapped inline definition; the same rule composes under Filter.
# FormalSQL/Rocq: BAG_EQ, verified 2026-09-05.
CTEConsumer<t0>|Input<t1>|TableEq(t1,t0)

# Replace CXformCTEAnchor2TrivialSelect after every consumer is eligible for
# inlining. The source-only anchor has the same relational result as its child;
# the matcher retains ORCA's consumer-count, outer-reference and safety gates.
# FormalSQL/Rocq: BAG_EQ, verified 2026-09-06.
