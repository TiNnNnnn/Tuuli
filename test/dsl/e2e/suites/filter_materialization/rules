# Generic predicate Context materialization; conditional native instances checked.
# The ErrorFree domain does not replace the legacy deferred-error domain.
Compute<e0 a0 s0>(Filter<p0 a1>(Input<t0>))|Compute<e1 a2 s1>(Filter<p1 a3>(LeftApply(Input<t1>,Input<t2>)))|Context(n0) := p0;Subquery(a4,t3) := n0;t1 := t0;t2 := t3;e1 := e0;a2 := a0;s1 := s0;n1 := Column(a4);p1 := Context(p0,n1);a3 := ScalarDeps(p1);OutputAttrs(a5,t0);OutputAttrs(a6,t3);DepsDisjoint(a5,a6);DepsDisjoint(p0,a6);DepsDisjoint(e0,a6);ErrorFree(n0);Deterministic(n0)
