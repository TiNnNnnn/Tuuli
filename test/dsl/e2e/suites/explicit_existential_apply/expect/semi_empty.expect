{
  "description": "显式 Semi/AntiApply 构造：关闭原生子查询 lowering，保留重复度、NULL 与可观察错误",
  "plans": [
    {
      "name": "dsl-off",
      "dsl": false,
      "trace": true,
      "contains": [
        "Optimizer: pg_orca"
      ],
      "not_contains": [
        "Falling back to Postgres"
      ]
    },
    {
      "name": "replacement",
      "trace": true,
      "disable_xforms": [
        "CXformSelect2Apply",
        "CXformSubquery2CorrelatedApply"
      ],
      "policy": "construct.policy",
      "contains": [
        "Optimizer: pg_orca",
        "\"status\":\"applied\",\"rule_hash\":\"c10790cd2aca029b\"",
        "Rule: Exists("
      ],
      "not_contains": [
        "Falling back to Postgres"
      ],
      "alternative": [
        "CXformDSLRule_Select"
      ],
      "provenance": {
        "required_sources": [
          "dsl"
        ],
        "required_origins": [],
        "forbidden_origins": [
          "CXformSelect2Apply",
          "CXformSubquery2CorrelatedApply"
        ]
      }
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformSelect2Apply",
      "CXformSubquery2CorrelatedApply"
    ],
    "policy": "construct.policy",
    "output": [],
    "postgres_output": []
  }
}
