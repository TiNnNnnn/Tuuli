# Existing compositional FormalSQL OUTCOME_EQ proofs; explicit ordinary Apply, no implicit unnesting.
# Expose a DISTINCT subquery's actual input, including any Filter. No legacy
# PredicateExists/NotExists or ExprList* constructor participates in this suite.
Exists(Input<t0>,Proj*<a0 s0>(Input<t1>))|Exists(Input<t2>,Input<t3>)|t2 := t0;t3 := t1;AttrsSub(a0,t1)
NotExists(Input<t0>,Proj*<a0 s0>(Input<t1>))|NotExists(Input<t2>,Input<t3>)|t2 := t0;t3 := t1;AttrsSub(a0,t1)
# Safe conjunction split with explicit EXISTS capture and independently derived dependencies.
# db63fb9399c5830db5de6cf9c873b4ec79a327d87aa8cf003dac8aa25840b5fa
Filter<And(p0,p1) a0>(Input<t0>)|Filter<p2 a1>(Filter<p3 a2>(Input<t2>))|Exists(t1) := p1;t2 := t0;p2 := p0;p3 := p1;n0 := BoolValue(p0);n1 := BoolValue(p1);a1 := ScalarDeps(n0);a2 := ScalarDeps(n1);ErrorFree(p0);ErrorFree(p1);Deterministic(p0);Deterministic(p1)
# Negated capture, same generic split proof: a46ea6ce3f0e77e274411f110cfb7d28238b46d777cc2d48d55645db6bee9b68
Filter<And(p0,p1) a0>(Input<t0>)|Filter<p2 a1>(Filter<p3 a2>(Input<t2>))|Not(p4) := p1;Exists(t1) := p4;t2 := t0;p2 := p0;p3 := p1;n0 := BoolValue(p0);n1 := BoolValue(p1);a1 := ScalarDeps(n0);a2 := ScalarDeps(n1);ErrorFree(p0);ErrorFree(p1);Deterministic(p0);Deterministic(p1)
# Native FormalSQL OUTCOME_EQ: lower existential Filters with arbitrary inputs.
# Derive actual outer references and intersect them with the current left input.
# This retains references to enclosing queries without misdeclaring them as
# immediate Apply correlation; no prescribed nested-Filter shape is required.
# Semi certificate: e5f903ede9d6646046a3b5f9fd124ea5742f731f178c803ae24ed99661daca76
Exists(Input<t0>,Filter<p0 a0 a1>(Input<t1>))|SemiApply<p1 a2 a3 a4>(Input<t2>,Input<t3>)|t2 := t0;t3 := t1;p1 := p0;a2 := a1;a3 := a0;p2 := Exists(t1);n0 := BoolValue(p2);a5 := ScalarDeps(n0);AttrsIntersect(a4,a5,t0)
# Anti certificate: d9e868ed16192c02a31ceddcc1bdb4ca0e9a6e2a31f1542575a72034b688c170
NotExists(Input<t0>,Filter<p0 a0 a1>(Input<t1>))|AntiApply<p1 a2 a3 a4>(Input<t2>,Input<t3>)|t2 := t0;t3 := t1;p1 := p0;a2 := a1;a3 := a0;p2 := Exists(t1);n0 := BoolValue(p2);a5 := ScalarDeps(n0);AttrsIntersect(a4,a5,t0)
