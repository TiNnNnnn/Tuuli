{
  "description": "Reference-based removal also preserves bag multiplicity without a base-table unique key; the first DSL rule keeps an explicit RHS dedup",
  "plans": [
    {
      "name": "dsl-on",
      "trace": true,
      "disable_xforms": [
        "CXformSelect2Apply",
        "CXformSubquery2CorrelatedApply",
        "CXformLeftSemiJoin2InnerJoin",
        "CXformLeftSemiJoin2InnerJoinUnderGb",
        "CXformSimplifyGbAgg"
      ],
      "contains": [
        "Optimizer: pg_orca",
        "\"status\":\"applied\",\"rule_hash\":\"b24ead64771bc9fb\"",
        "\"status\":\"applied\",\"rule_hash\":\"41f0464b2d141f50\""
      ],
      "not_contains": [
        "Falling back to Postgres"
      ],
      "joins": 0
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformSelect2Apply",
      "CXformSubquery2CorrelatedApply",
      "CXformLeftSemiJoin2InnerJoin",
      "CXformLeftSemiJoin2InnerJoinUnderGb",
      "CXformSimplifyGbAgg"
    ],
    "output": [
