{
  "description": "Export ordered Compute definitions without losing child columns, validated by the production parser and matcher",
  "plans": [
    {
      "name": "export",
      "dsl": false,
      "trace": true,
      "stats_experiment": "plan-slice.yaml",
      "contains": [
        "Optimizer: pg_orca"
      ],
      "not_contains": [
        "Falling back to Postgres"
      ],
      "plan_slice": {
        "schema": "pgorca.dsl.plan-slice.v1",
        "root_path": "r",
        "cut_paths": [
          "r/0"
        ],
        "status": "ok",
        "source_template": "Compute<Item(Call(h0,Args(Column(a1),Args(n0,Args()))),a2,Item(Call(h1,Args(Column(a3),Args(n1,Args()))),a4,Item(Call(h2,Args(Column(a5),Args(n2,Args()))),a6,e0))) a0 s0>(Input<t0>)",
        "error": null
      }
    }
  ]
}
