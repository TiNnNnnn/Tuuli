{
  "description": "Export lazy CASE structure from the native plan, retaining ordered opaque value captures",
  "plans": [
    {
      "name": "export",
      "dsl": false,
      "trace": true,
      "stats_experiment": "plan-slice.yaml",
      "contains": [
        "Optimizer: pg_orca"
      ],
      "not_contains": [
        "Falling back to Postgres"
      ],
      "plan_slice": {
        "schema": "pgorca.dsl.plan-slice.v1",
        "root_path": "r",
        "cut_paths": [
          "r/0"
        ],
        "status": "ok",
        "source_template": "Proj<a0 s0 Item(Case(ValueBool(Call(h0,Args(n0,Args(n1,Args())))),Call(h1,Args(n2,Args(n3,Args()))),n4),a1,e0)>(Input<t0>)",
        "error": null
      }
    }
  ]
}
