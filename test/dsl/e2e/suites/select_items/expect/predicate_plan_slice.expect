{
  "description": "Export a Boolean CASE under a native filter without flattening its value tree",
  "plans": [
    {
      "name": "export",
      "dsl": false,
      "trace": true,
      "stats_experiment": "predicate-plan-slice.yaml",
      "contains": [
        "Optimizer: pg_orca"
      ],
      "not_contains": [
        "Falling back to Postgres"
      ],
      "plan_slice": {
        "schema": "pgorca.dsl.plan-slice.v1",
        "root_path": "r/0",
        "cut_paths": [
          "r/0/0"
        ],
        "status": "ok",
        "source_template": "Filter<ValueBool(Case(ValueBool(Call(h0,Args(n0,Args(n1,Args())))),Call(h1,Args(n2,Args(n3,Args()))),Call(h2,Args(n4,Args(n5,Args()))))) a0>(Input<t0>)",
        "error": null
      }
    }
  ]
}
