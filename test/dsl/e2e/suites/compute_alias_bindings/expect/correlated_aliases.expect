{
  "description": "相关别名投影被 Apply 隔开，源路由候选为零；不计作 Compute 合并触发",
  "plans": [
    {
      "name": "dsl-off",
      "dsl": false,
      "trace": true,
      "disable_xforms": [
        "CXformCollapseProject"
      ],
      "policy": "construct.policy",
      "contains": [
        "Optimizer: pg_orca"
      ],
      "not_contains": [
        "\"status\":\"applied\"",
        "Falling back to Postgres"
      ]
    },
    {
      "name": "dsl-on",
      "trace": true,
      "disable_xforms": [
        "CXformCollapseProject"
      ],
      "policy": "construct.policy",
      "contains": [
        "Optimizer: pg_orca",
        "CLogicalLeftOuterCorrelatedApply",
        "\"candidate_rules\":0"
      ],
      "not_contains": [
        "\"status\":\"applied\"",
        "Falling back to Postgres"
      ]
    }
  ],
  "rows": {
