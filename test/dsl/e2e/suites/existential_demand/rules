# Existing proved rules: safe conjunction split followed by arbitrary-input existential Apply.
Filter<And(p0,p1) a0>(Input<t0>)|Filter<p2 a1>(Filter<p3 a2>(Input<t2>))|Exists(t1) := p1;t2 := t0;p2 := p0;p3 := p1;n0 := BoolValue(p0);n1 := BoolValue(p1);a1 := ScalarDeps(n0);a2 := ScalarDeps(n1);ErrorFree(p0);ErrorFree(p1);Deterministic(p0);Deterministic(p1)
Filter<And(p0,p1) a0>(Input<t0>)|Filter<p2 a1>(Filter<p3 a2>(Input<t2>))|Not(p4) := p1;Exists(t1) := p4;t2 := t0;p2 := p0;p3 := p1;n0 := BoolValue(p0);n1 := BoolValue(p1);a1 := ScalarDeps(n0);a2 := ScalarDeps(n1);ErrorFree(p0);ErrorFree(p1);Deterministic(p0);Deterministic(p1)
Filter<Exists(t1) a0 a1>(Input<t0>)|SemiApply(Input<t2>,Input<t3>)|t2 := t0;t3 := t1
Filter<Not(Exists(t1)) a0 a1>(Input<t0>)|AntiApply(Input<t2>,Input<t3>)|t2 := t0;t3 := t1
