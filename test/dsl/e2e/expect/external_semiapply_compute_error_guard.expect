{
  "description": "A potentially failing RHS computation cannot be moved out of per-row SemiApply demand",
  "plans": [
    {
      "name": "guard",
      "trace": true,
      "disable_xforms": [
        "CXformLeftSemiApplyWithExternalCorrs2InnerJoin"
      ],
      "policy": "isolate_external_semiapply_in_base.policy",
      "contains": [
        "\"status\":\"constraint_rejected\",\"rule_hash\":\"1ab0ec8efdf91762\"",
        "\"failed_constraint\":\"ErrorFree\""
      ],
      "not_contains": [
        "\"status\":\"applied\",\"rule_hash\":\"1ab0ec8efdf91762\""
      ]
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformLeftSemiApplyWithExternalCorrs2InnerJoin"
    ],
    "policy": "isolate_external_semiapply_in_base.policy",
    "output": [],
    "postgres_output": []
  }
}
