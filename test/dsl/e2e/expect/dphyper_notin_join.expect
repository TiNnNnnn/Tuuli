{
  "description": "With two non-null keys DPHyper enumerates the ordinary anti join produced by NOT IN",
  "plans": [
    {
      "name": "replacement-dsl",
      "dsl": true,
      "dphyper": true,
      "dphyper_shadow": false,
      "trace": true,
      "contains": [
        "Optimizer: pg_orca",
        "DPHyper: status=applied",
        "mode=replacement"
      ],
      "joins": 2
    },
    {
      "name": "replacement",
      "dsl": false,
      "dphyper": true,
      "dphyper_shadow": false,
      "trace": true,
      "contains": [
        "Optimizer: pg_orca",
        "DPHyper: status=applied",
        "root=CLogicalInnerJoin nodes=3",
        "mode=replacement",
        "\"operator\":\"CLogicalLeftAntiSemiJoin\",\"source\":\"dphyper\",\"origin\":\"CXformDPHyperJoinRegion\""
      ],
      "not_contains": [
        "Xform: CXformExpandNAryJoinDPv2",
        "Xform: CXformAntiSemiJoinNotInInnerJoinSwap"
      ],
      "joins": 2
    }
  ],
  "rows": {
    "dphyper": true,
    "dphyper_shadow": false,
    "output": [
      "2,2"
    ],
    "postgres_output": [
      "2,2"
    ]
  }
}
