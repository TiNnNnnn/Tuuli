{
  "description": "Repeated references reuse a volatile scalar subquery result rather than execute it again",
  "plans": [
    {
      "name": "replacement",
      "trace": true,
      "disable_xforms": [
        "CXformCollapseProject"
      ],
      "contains": [
        "Optimizer: pg_orca",
        "SubPlan 1",
        "Aggregate\n   ->  Result"
      ],
      "not_contains": [
        "Falling back to Postgres"
      ]
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformCollapseProject"
    ],
    "output": [
      "2"
    ],
    "postgres_output": [
      "2"
    ],
    "off_output": [
      "2"
    ]
  }
}
