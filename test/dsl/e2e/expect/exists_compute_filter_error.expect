{
  "description": "移除 EXISTS 未求值的 Compute 不能吞掉内侧 Filter 的除零错误",
  "plans": [
    {
      "name": "replacement",
      "trace": true,
      "disable_xforms": [
        "CXformSelect2Apply",
        "CXformSubquery2CorrelatedApply"
      ],
      "policy": "isolate_explicit_existential_apply.policy",
      "contains": [
        "Optimizer: pg_orca",
        "\"status\":\"applied\",\"rule_hash\":\"f91ba8ce73b0da11\"",
        "\"status\":\"applied\",\"rule_hash\":\"593ad0723f91cfd4\""
      ],
      "not_contains": [
        "Falling back to Postgres"
      ]
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformSelect2Apply",
      "CXformSubquery2CorrelatedApply"
    ],
    "policy": "isolate_explicit_existential_apply.policy",
    "error_sqlstate": "22012",
